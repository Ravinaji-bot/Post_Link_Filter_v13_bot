# Required
BOT_TOKEN=123456:your_bot_token
API_ID=123456
API_HASH=your_api_hash
DATABASE_URI=mongodb+srv://username:db-password@cluster.mongodb.net/
LOG_CHANNEL=-1001234567890
ADMINS=123456789
OWNER_ID=123456789

# Recommended
CHANNELS=-1001234567890
BIN_CHANNEL=-1001234567890
DATABASE_NAME=Cluster0
COLLECTION_NAME=dreamcinezone_files

# Web and streaming
PORT=8080
FQDN=your-app-name.onrender.com
HAS_SSL=True
NO_PORT=True
STREAM_MODE=True
PREMIUM_STREAM_MODE=False

# Force subscription
AUTH_CHANNELS=-1001234567890
AUTH_REQ_CHANNELS=-1001234567890
REQST_CHANNEL_ID=-1001234567890
SUPPORT_CHAT_ID=-1001234567890
SUPPORT_CHAT=https://t.me/your_support_group

# Optional features
IS_VERIFY=False
MAINTENANCE=False
TMDB_API_KEY=
SHORTENER_WEBSITE=
SHORTENER_API=
TMDB_BEARER_TOKEN=
IMGBB_API_KEY=
FILE_DELETE_TIME=50
PM_POST_FIRST=True
POST_ARCHIVE_BEFORE=30
RESULT_ARCHIVE_CHANNEL=

# /start auto-delete (seconds)
START_CMD_DELETE_TIME=3
START_HOME_DELETE_TIME=300

# --- /autopost (optional: the /autopost commands can set these too) ---
AUTOPOST_MOVIE_CHANNEL=
AUTOPOST_SERIES_CHANNEL=
AUTOPOST_STICKER=
AUTOPOST_DELAY=2

# Group protection (plugins/antispam.py)
# master switch
ANTISPAM=True
# state of a group that never used /antispam on|off
ANTISPAM_DEFAULT_ON=True
# ban every bot that somebody adds to a group
ANTISPAM_BAN_BOTS=True
# always allowed links / @names / domains, separated by space or comma, e.g. "@mychannel mysite.com"
ANTISPAM_ALLOWED=
